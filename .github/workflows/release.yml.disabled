name: "Release"

# DISABLED: rename this file to release.yml to enable it. Before that, set up:
#   - secret SIGNING_CERT_P12 (base64 of a self-signed code signing certificate's .p12)
#     and SIGNING_CERT_PASSWORD; the build is signed with it to keep a stable identity
#   - repository variable EXPECTED_CERT_SHA1 (lowercase SHA-1 of that certificate,
#     no colons): the build is checked against it
#   - secret VIRUSTOTAL_API_KEY (optional: without it the scan is skipped)
#
# A new MARKETING_VERSION merged to main (or a v* tag) builds, attests, scans and
# publishes a GitHub release.
# Pull requests only build the DMG and upload it as an artifact.
on:
  push:
    branches: [ "main" ]
    paths:
      - "FortiBar.xcodeproj/project.pbxproj"
    tags: [ "v*" ]
  workflow_dispatch:
  pull_request:
    branches: [ "main" ]
    paths:
      - "FortiBar/**"
      - "FortiBar.xcodeproj/**"
      - "build_dmg.sh"
      - ".github/workflows/release.yml"

permissions:
  contents: read

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

defaults:
  run:
    shell: bash

jobs:
  # Cheap Linux job: decides whether this run releases, so no-op pushes never wait for a macOS runner
  prepare:
    name: Decide release
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      tag: ${{ steps.decide.outputs.tag }}
      release: ${{ steps.decide.outputs.release }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Decide release
        id: decide
        run: |
          if [ "$GITHUB_EVENT_NAME" = "pull_request" ]; then
            echo "Pull request: build only"
            echo "release=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          if [[ "$GITHUB_REF" == refs/tags/v* ]]; then
            echo "Tag $GITHUB_REF_NAME pushed: release it"
            { echo "tag=$GITHUB_REF_NAME"; echo "release=true"; } >> "$GITHUB_OUTPUT"
            exit 0
          fi

          if [ "$GITHUB_REF" != "refs/heads/main" ]; then
            echo "Releases only come from main, not $GITHUB_REF"
            echo "release=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          # Push to main or manual run: release the project version if it has no tag yet
          VERSIONS=$(grep -oE 'MARKETING_VERSION = [^;]+' FortiBar.xcodeproj/project.pbxproj | awk '{print $3}' | sort -u)
          if [ -z "$VERSIONS" ] || [ "$(wc -l <<< "$VERSIONS")" -ne 1 ]; then
            echo "::error::Expected one MARKETING_VERSION in the project, found: $(echo "$VERSIONS" | tr '\n' ' ')"
            exit 1
          fi
          TAG="v$VERSIONS"
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

          if git ls-remote --exit-code --tags origin "refs/tags/$TAG" > /dev/null; then
            echo "$TAG already exists: nothing to release"
            echo "release=false" >> "$GITHUB_OUTPUT"
          else
            echo "$TAG is new: release it"
            echo "release=true" >> "$GITHUB_OUTPUT"
          fi

  release:
    name: ${{ needs.prepare.outputs.release == 'true' && 'Build and release' || 'Build' }}
    needs: prepare
    if: github.event_name == 'pull_request' || needs.prepare.outputs.release == 'true'
    runs-on: macos-26
    timeout-minutes: 45
    permissions:
      contents: write       # create the GitHub release and its tag
      id-token: write       # sign the build provenance with Sigstore
      attestations: write   # store the attestation on GitHub
    env:
      RELEASE: ${{ needs.prepare.outputs.release }}
      TAG: ${{ needs.prepare.outputs.tag }}
      # SHA-1 of the "FortiBar Self-Signed" certificate (public), kept in a repository variable
      EXPECTED_CERT_SHA1: ${{ vars.EXPECTED_CERT_SHA1 }}

    steps:
      - name: Checkout repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Select Xcode 26
        run: |
          shopt -s nullglob
          candidates=(/Applications/Xcode_26*.app)
          if [ ${#candidates[@]} -gt 0 ]; then
            sudo xcode-select -s "$(printf '%s\n' "${candidates[@]}" | sort -V | tail -n 1)"
          fi
          # Read the whole output first: piping xcodebuild into head/grep -q can kill it with SIGPIPE
          XCODE_VERSION=$(xcodebuild -version)
          echo "$XCODE_VERSION"
          # The project uses Swift settings introduced in Xcode 26
          if [[ ! "$XCODE_VERSION" =~ ^Xcode\ (2[6-9]|[3-9][0-9]) ]]; then
            echo "::error::Xcode 26 or later is required"
            ls /Applications
            exit 1
          fi

      - name: Import signing certificate
        env:
          P12_BASE64: ${{ secrets.SIGNING_CERT_P12 }}
          P12_PASSWORD: ${{ secrets.SIGNING_CERT_PASSWORD }}
        run: |
          if [ -z "$P12_BASE64" ]; then
            if [ "$RELEASE" = "true" ]; then
              echo "::error::SIGNING_CERT_P12 is not set: releases must keep the stable signing identity"
              exit 1
            fi
            echo "::warning::No signing certificate (e.g. pull request from a fork): ad-hoc build"
            exit 0
          fi

          # Throwaway keychain, unlocked for the whole job so codesign never prompts
          KEYCHAIN="$RUNNER_TEMP/signing.keychain-db"
          KEYCHAIN_PASSWORD=$(openssl rand -base64 24)
          P12="$RUNNER_TEMP/signing.p12"
          base64 --decode <<< "$P12_BASE64" > "$P12"
          security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
          security set-keychain-settings -lut 21600 "$KEYCHAIN"
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN"
          security import "$P12" -k "$KEYCHAIN" -P "$P12_PASSWORD" -T /usr/bin/codesign
          security set-key-partition-list -S apple-tool:,apple: -s -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN" > /dev/null
          rm -f "$P12"

          # codesign only looks for identities in keychains on the user search list
          EXISTING=$(security list-keychains -d user | tr -d '"' | xargs)
          # shellcheck disable=SC2086 # keychain paths contain no spaces
          security list-keychains -d user -s "$KEYCHAIN" $EXISTING
          echo "SIGN_KEYCHAIN=$KEYCHAIN" >> "$GITHUB_ENV"

      - name: Build universal DMG
        id: build
        run: ./build_dmg.sh

      - name: Check architectures and signature
        env:
          APP: ${{ steps.build.outputs.app }}
        run: |
          ARCHS=$(lipo -archs "$APP/Contents/MacOS/FortiBar")
          echo "Architectures: $ARCHS"
          if [[ "$ARCHS" != *arm64* || "$ARCHS" != *x86_64* ]]; then
            echo "::error::Expected a universal binary, got: $ARCHS"
            exit 1
          fi
          codesign --verify --deep --strict "$APP"

          REQUIREMENT=$(codesign -d -r- "$APP" 2>&1)
          echo "$REQUIREMENT"
          # With the certificate available the app must carry its stable identity, never ad-hoc
          if [ -n "$SIGN_KEYCHAIN" ] && [[ "$REQUIREMENT" != *"certificate leaf = H\"$EXPECTED_CERT_SHA1\""* ]]; then
            echo "::error::App is not signed with the expected certificate ($EXPECTED_CERT_SHA1)"
            exit 1
          fi

      - name: Check tag matches app version
        if: env.RELEASE == 'true'
        env:
          VERSION: ${{ steps.build.outputs.version }}
        run: |
          TAG_VERSION="${TAG#v}"
          # v1.3.1-rc.1 is a test build of 1.3.1
          if [ "${TAG_VERSION%%-*}" != "$VERSION" ]; then
            echo "::error::Tag $TAG does not match MARKETING_VERSION $VERSION"
            exit 1
          fi

      - name: Upload DMG artifact
        if: env.RELEASE != 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: ${{ steps.build.outputs.dmg }}
          path: ${{ steps.build.outputs.dmg }}
          if-no-files-found: error
          retention-days: 14

      - name: Attest build provenance
        if: env.RELEASE == 'true'
        uses: actions/attest-build-provenance@4d101475d8b20a2381f78447822ac1eab6504dd8 # v4.2.2
        with:
          subject-path: ${{ steps.build.outputs.dmg }}

      - name: Scan with VirusTotal
        id: virustotal
        if: env.RELEASE == 'true'
        # A VirusTotal outage must not block the release
        continue-on-error: true
        env:
          VT_API_KEY: ${{ secrets.VIRUSTOTAL_API_KEY }}
          DMG: ${{ steps.build.outputs.dmg }}
          SHA256: ${{ steps.build.outputs.sha256 }}
        run: |
          if [ -z "$VT_API_KEY" ]; then
            echo "::warning::VIRUSTOTAL_API_KEY is not set, skipping the scan"
            exit 0
          fi

          ANALYSIS_ID=$(curl -sS --fail-with-body -X POST "https://www.virustotal.com/api/v3/files" \
            -H "x-apikey: $VT_API_KEY" -F "file=@$DMG" | jq -r '.data.id')
          LINK="https://www.virustotal.com/gui/file/$SHA256"
          echo "link=$LINK" >> "$GITHUB_OUTPUT"

          # The free API allows 4 requests per minute: poll every 30s for up to 3 minutes
          STATS=""
          for _ in 1 2 3 4 5 6; do
            sleep 30
            RESULT=$(curl -sS --fail-with-body "https://www.virustotal.com/api/v3/analyses/$ANALYSIS_ID" \
              -H "x-apikey: $VT_API_KEY")
            if [ "$(jq -r '.data.attributes.status' <<< "$RESULT")" = "completed" ]; then
              STATS=$(jq -r '.data.attributes.stats | "\(.malicious) malicious, \(.suspicious) suspicious, \(.undetected) undetected"' <<< "$RESULT")
              break
            fi
          done

          {
            echo "### VirusTotal"
            echo "[$LINK]($LINK): ${STATS:-analysis still running}"
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Publish GitHub release
        if: env.RELEASE == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
          VERSION: ${{ steps.build.outputs.version }}
          DMG: ${{ steps.build.outputs.dmg }}
          SHA256: ${{ steps.build.outputs.sha256 }}
          VT_LINK: ${{ steps.virustotal.outputs.link }}
        run: |
          RUN_URL="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID"
          {
            echo "## Install"
            echo
            echo "Install openfortivpn (\`brew install openfortivpn\`), then download \`$DMG\` below. The app is not notarized: on first launch open **System Settings → Privacy & Security** and click **Open Anyway**, then **Settings → Permission → Set Up…**."
            echo
            # This version's CHANGELOG section, headings promoted one level
            awk -v heading="## v$VERSION" '$0 == heading {found=1; next} found && /^## v/ {exit} found' CHANGELOG.md \
              | sed 's/^### /## /'
            echo
            echo "## Verify this download"
            echo
            echo "Built by [GitHub Actions]($RUN_URL) from the tagged commit."
            echo
            echo "- SHA-256: \`$SHA256\`"
            echo "- Build provenance: \`gh attestation verify $DMG -R $GITHUB_REPOSITORY\`"
            if [ -n "$VT_LINK" ]; then
              echo "- VirusTotal: $VT_LINK"
            fi
          } > release-notes.md

          # --target creates the tag on this commit when it does not exist yet (release from main)
          ARGS=(--target "$GITHUB_SHA" --title "$TAG" --notes-file release-notes.md)
          if [[ "$TAG" == *-* ]]; then
            ARGS+=(--prerelease)
          fi
          gh release create "$TAG" "$DMG" "${ARGS[@]}"

      - name: Remove signing keychain
        if: always() && env.SIGN_KEYCHAIN != ''
        run: security delete-keychain "$SIGN_KEYCHAIN"
